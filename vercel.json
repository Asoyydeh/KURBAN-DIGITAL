{
  "version": 2,
  "framework": null,
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/tiktok/stream",
      "destination": "/api/tiktok/stream"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/$1"
    }
  ]
}
